---
interface Highlight {
  title: string;
  text: string;
}

interface ValueItem {
  title: string;
  text: string;
}

interface Props {
  eyebrow: string;
  titleLead: string;
  titleAccent: string;
  text: string;
  image: string;
  imageAlt: string;
  highlights: readonly Highlight[];
  values: readonly ValueItem[];
}

const { eyebrow, titleLead, titleAccent, text, image, imageAlt, highlights, values } = Astro.props;
---

<section data-nav="dark" class="team-show relative overflow-hidden bg-nuit text-ivoire">
  <!-- Motifs de fond discrets -->
  <div class="team-show__motif pointer-events-none absolute inset-0" aria-hidden="true"></div>

  <div class="site-shell relative z-10 pt-[clamp(3.5rem,6vw,6.5rem)] pb-[clamp(5.5rem,9vw,8.5rem)]">
    <div class="grid items-center gap-10 lg:grid-cols-12 lg:gap-8 xl:gap-12">
      <!-- Éditorial -->
      <div class="reveal lg:col-span-5">
        <p class="type-eyebrow text-or">{eyebrow}</p>
        <h2 class="type-display mt-5 leading-[1.08]">
          <span class="text-ivoire">{titleLead}</span>
          <span class="block text-or">{titleAccent}</span>
        </h2>
        <p class="type-lead mt-6 max-w-md text-ivoire/70">{text}</p>

        <ul class="team-show__highlights mt-10 grid gap-6 sm:grid-cols-3 lg:grid-cols-1 xl:grid-cols-3">
          {
            highlights.map((item, i) => (
              <li
                class:list={[
                  'reveal flex items-start gap-3 xl:flex-col xl:items-center xl:text-center',
                  i === 1 && 'reveal-delay-1',
                  i === 2 && 'reveal-delay-2',
                ]}
              >
                <span class="team-show__icon" aria-hidden="true">
                  {i === 0 && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M3 17 12 7l9 10M12 7v12M5.5 10.5h13"
                      />
                    </svg>
                  )}
                  {i === 1 && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                      <rect x="7" y="9" width="10" height="11" rx="1.5" />
                      <path stroke-linecap="round" d="M10 9V7.5a2 2 0 0 1 4 0V9M12 4.5V6" />
                    </svg>
                  )}
                  {i === 2 && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                      <circle cx="12" cy="8" r="3.25" />
                      <path
                        stroke-linecap="round"
                        d="M5.5 19.5c1.2-3.2 3.4-4.8 6.5-4.8s5.3 1.6 6.5 4.8"
                      />
                    </svg>
                  )}
                </span>
                <div>
                  <p class="text-sm font-medium tracking-wide text-ivoire">{item.title}</p>
                  <p class="mt-1 text-xs leading-relaxed text-ivoire/55">{item.text}</p>
                </div>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Photo organique -->
      <div class="reveal reveal-delay-1 relative lg:col-span-7">
        <div class="team-show__photo-wrap">
          <div class="team-show__photo-frame">
            <img
              src={image}
              alt={imageAlt}
              width="1400"
              height="1400"
              class="team-show__photo"
              loading="lazy"
              decoding="async"
            />
          </div>
          <svg class="team-show__ring" viewBox="0 0 100 100" aria-hidden="true">
            <circle
              cx="50"
              cy="50"
              r="48.5"
              fill="none"
              stroke="currentColor"
              stroke-width="0.55"
              stroke-dasharray="8 4 2 4"
              opacity="0.85"
            />
          </svg>
        </div>
      </div>
    </div>
  </div>

  <!-- Bandeau valeurs — chevauchement bas -->
  <div class="relative z-20 site-shell -mt-8 pb-10 md:-mt-12 md:pb-14">
    <ul class="team-show__values reveal reveal-delay-2">
      {
        values.map((v, i) => (
          <li class="team-show__value">
            <span class="team-show__value-icon" aria-hidden="true">
              {i === 0 && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4">
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M12 3.5 5.5 6.5v5.2c0 4.1 2.7 7.2 6.5 8.8 3.8-1.6 6.5-4.7 6.5-8.8V6.5L12 3.5Z"
                  />
                </svg>
              )}
              {i === 1 && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4">
                  <circle cx="9" cy="9" r="2.5" />
                  <circle cx="16" cy="10" r="2.2" />
                  <path
                    stroke-linecap="round"
                    d="M3.5 18.5c.9-2.6 2.7-3.9 5.5-3.9 1.6 0 2.9.4 3.9 1.2M12.5 18.5c.7-1.8 2-2.8 4-2.8 2.2 0 3.5 1.1 4 2.8"
                  />
                </svg>
              )}
              {i === 2 && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4">
                  <path
                    stroke-linejoin="round"
                    d="m12 4.2 1.9 4.7 5.1.4-3.9 3.3 1.2 5-4.3-2.6-4.3 2.6 1.2-5-3.9-3.3 5.1-.4L12 4.2Z"
                  />
                </svg>
              )}
              {i === 3 && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4">
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M12 19.5s-6.5-4.1-6.5-9A3.7 3.7 0 0 1 12 8.2 3.7 3.7 0 0 1 18.5 10.5c0 4.9-6.5 9-6.5 9Z"
                  />
                </svg>
              )}
            </span>
            <div>
              <p class="font-medium tracking-wide text-ivoire">{v.title}</p>
              <p class="mt-1 text-xs leading-relaxed text-ivoire/55 md:text-[0.8rem]">{v.text}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>

  <!-- Vague vers la section claire suivante -->
  <div class="team-show__wave pointer-events-none absolute inset-x-0 bottom-0 h-16 md:h-20" aria-hidden="true"></div>
</section>

<style>
  .team-show {
    --team-navy: var(--color-azur-profond);
  }

  .team-show__motif {
    background:
      radial-gradient(ellipse 50% 60% at 8% 70%, color-mix(in srgb, var(--color-azur) 18%, transparent), transparent 60%),
      radial-gradient(ellipse 40% 50% at 92% 20%, color-mix(in srgb, var(--color-or) 10%, transparent), transparent 55%);
    opacity: 0.9;
  }

  .team-show__icon {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    flex-shrink: 0;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--color-or) 55%, transparent);
    color: var(--color-or);
  }

  .team-show__icon svg {
    width: 1.15rem;
    height: 1.15rem;
  }

  .team-show__photo-wrap {
    position: relative;
    width: min(100%, 34rem);
    margin-inline: auto;
    aspect-ratio: 1;
  }

  @media (min-width: 1024px) {
    .team-show__photo-wrap {
      width: min(100%, 38rem);
      margin-inline: auto 0;
    }
  }

  .team-show__photo-frame {
    position: absolute;
    inset: 4%;
    overflow: hidden;
    border-radius: 58% 42% 48% 52% / 48% 55% 45% 52%;
    box-shadow:
      0 0 0 1px color-mix(in srgb, var(--color-or) 45%, transparent),
      0 28px 60px rgba(0, 0, 0, 0.28);
  }

  .team-show__photo {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 20%;
    transform: scale(1.03);
    transition: transform 1.1s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .team-show:hover .team-show__photo {
    transform: scale(1);
  }

  .team-show__ring {
    position: absolute;
    inset: 0;
    color: var(--color-or);
    pointer-events: none;
    opacity: 0.75;
  }

  .team-show__values {
    display: grid;
    gap: 1.25rem;
    padding: 1.35rem 1.25rem;
    border-radius: 1.15rem;
    background: color-mix(in srgb, var(--color-azur-profond) 92%, #000);
    border: 1px solid color-mix(in srgb, var(--color-or) 28%, transparent);
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.22);
    grid-template-columns: 1fr;
  }

  @media (min-width: 640px) {
    .team-show__values {
      grid-template-columns: 1fr 1fr;
      padding: 1.5rem 1.5rem;
      gap: 1.5rem;
    }
  }

  @media (min-width: 1024px) {
    .team-show__values {
      grid-template-columns: repeat(4, 1fr);
      gap: 1.25rem;
      padding: 1.6rem 1.75rem;
    }
  }

  .team-show__value {
    display: flex;
    gap: 0.85rem;
    align-items: flex-start;
  }

  .team-show__value-icon {
    display: grid;
    place-items: center;
    width: 2.15rem;
    height: 2.15rem;
    flex-shrink: 0;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--color-or) 60%, transparent);
    color: var(--color-or);
  }

  .team-show__value-icon svg {
    width: 1rem;
    height: 1rem;
  }

  .team-show__wave {
    background: linear-gradient(180deg, transparent, var(--color-blanc));
    opacity: 0.95;
  }

  @media (prefers-reduced-motion: reduce) {
    .team-show__photo,
    .team-show:hover .team-show__photo {
      transition: none;
      transform: none;
    }
  }
</style>
