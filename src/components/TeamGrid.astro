---
interface Member {
  id: string;
  name: string;
  role: string;
  bio: string;
  image: string;
  imageAlt?: string;
}

interface Props {
  eyebrow: string;
  title: string;
  members: readonly Member[];
}

const { eyebrow, title, members } = Astro.props;
---

<section data-nav="light" class="team-grid section-pad relative overflow-hidden bg-blanc">
  <div class="team-grid__glow pointer-events-none absolute inset-0" aria-hidden="true"></div>

  <div class="site-shell relative z-10">
    <div class="reveal mx-auto max-w-3xl text-center">
      <p class="type-eyebrow text-or">{eyebrow}</p>
      <h2 class="type-display mt-4 text-nuit">{title}</h2>
      <div class="gold-rule mx-auto mt-7"></div>
    </div>

    <ul class="mt-16 grid gap-20 sm:grid-cols-2 lg:mt-20 lg:grid-cols-4 lg:gap-x-12 lg:gap-y-24">
      {
        members.map((member, i) => (
          <li
            class:list={[
              'team-member reveal',
              i === 1 && 'reveal-delay-1',
              i === 2 && 'reveal-delay-2',
              i === 3 && 'reveal-delay-3',
            ]}
          >
            <div class="team-member__media">
              {/*
                Arc inférieur + pastilles (copie exacte du template Meet Our Team).
                viewBox centré : photo r≈62, arc r≈74, balayant le bas.
              */}
              <svg class="team-member__arc" viewBox="0 0 200 200" aria-hidden="true">
                {/*
                  Arc bas jusqu’à mi-hauteur du cercle (y=100).
                  Centre 100,100 · r=84 · demi-cercle inférieur + pastilles.
                */}
                <path
                  d="M 16 100 A 84 84 0 0 0 184 100"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                />
                <circle cx="16" cy="100" r="4.25" fill="currentColor" />
                <circle cx="184" cy="100" r="4.25" fill="currentColor" />
              </svg>

              <div class="team-member__avatar">
                <img
                  src={member.image}
                  alt={member.imageAlt ?? member.name}
                  width="300"
                  height="300"
                  class="team-member__photo"
                  loading="lazy"
                  decoding="async"
                />
              </div>

              <span class="team-member__badge">{member.id}</span>
            </div>

            <h3 class="team-member__name">{member.name}</h3>
            <p class="team-member__role">{member.role}</p>
            <p class="team-member__bio">{member.bio}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .team-grid__glow {
    background:
      radial-gradient(
        ellipse 55% 45% at 15% 0%,
        color-mix(in srgb, var(--color-azur) 10%, transparent),
        transparent 70%
      ),
      radial-gradient(
        ellipse 45% 40% at 90% 100%,
        color-mix(in srgb, var(--color-or) 9%, transparent),
        transparent 65%
      );
  }

  .team-member {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .team-member__media {
    position: relative;
    width: 15.5rem;
    height: 15.5rem;
  }

  @media (min-width: 1024px) {
    .team-member__media {
      width: 17rem;
      height: 17rem;
    }
  }

  .team-member__arc {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    color: var(--color-or);
    pointer-events: none;
    z-index: 1;
    overflow: visible;
  }

  .team-member__avatar {
    position: absolute;
    /* Photo à l’intérieur de l’arc (r arc 84 → photo ~ r 70 → inset ~15%) */
    inset: 15%;
    z-index: 2;
    border-radius: 999px;
    overflow: hidden;
    background: var(--color-craie);
    box-shadow:
      inset 0 0 0 1.5px var(--color-or),
      0 0 0 1px color-mix(in srgb, var(--color-or) 30%, transparent);
    transition: transform 0.55s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .team-member:hover .team-member__avatar {
    transform: translateY(-4px) scale(1.025);
  }

  .team-member__photo {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    filter: grayscale(0.55) contrast(1.06);
    transition: filter 0.5s ease;
  }

  .team-member:hover .team-member__photo {
    filter: grayscale(0.1) contrast(1.02);
  }

  /* Badge 01 sur le bord haut du cercle photo */
  .team-member__badge {
    position: absolute;
    top: 15%;
    left: 50%;
    z-index: 4;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.65rem;
    height: 2.65rem;
    translate: -50% -50%;
    border-radius: 999px;
    background: var(--color-or);
    color: #fff;
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    box-shadow: 0 3px 12px rgba(18, 63, 112, 0.2);
  }

  .team-member__name {
    margin-top: 2.15rem;
    font-family: var(--font-sans);
    font-size: clamp(1.2rem, 1.05rem + 0.5vw, 1.4rem);
    font-weight: 700;
    line-height: 1.2;
    color: var(--color-or);
    transition: color 0.35s ease;
  }

  .team-member:hover .team-member__name {
    color: var(--color-azur-profond);
  }

  .team-member__role {
    margin-top: 0.45rem;
    font-family: var(--font-sans);
    font-size: 0.9rem;
    font-style: italic;
    font-weight: 400;
    color: #3a3a3a;
  }

  .team-member__bio {
    margin-top: 0.9rem;
    max-width: 16.5rem;
    font-family: var(--font-sans);
    font-size: 0.85rem;
    line-height: 1.55;
    color: #8a8a8a;
  }

  .team-member.is-visible .team-member__media {
    animation: team-float 5.5s ease-in-out infinite;
  }

  .team-member.is-visible:nth-child(2) .team-member__media {
    animation-delay: 0.35s;
  }

  .team-member.is-visible:nth-child(3) .team-member__media {
    animation-delay: 0.7s;
  }

  .team-member.is-visible:nth-child(4) .team-member__media {
    animation-delay: 1.05s;
  }

  @keyframes team-float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-5px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .team-member.is-visible .team-member__media,
    .team-member:hover .team-member__avatar {
      animation: none;
      transform: none;
      transition: none;
    }
  }
</style>
