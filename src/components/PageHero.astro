---
interface Props {
  eyebrow?: string;
  title: string;
  sub?: string;
  image: string;
  imageAlt?: string;
  compact?: boolean;
}

const { eyebrow, title, sub, image, imageAlt = '', compact = false } = Astro.props;
---

<section
  data-nav="dark"
  class:list={[
    'page-hero relative flex items-end overflow-hidden bg-nuit text-ivoire',
    compact ? 'page-hero--compact' : 'page-hero--tall',
  ]}
>
  <img
    src={image}
    alt={imageAlt}
    class:list={[
      'hero-media absolute inset-0 h-full w-full object-cover',
      compact && 'page-hero__media--compact',
    ]}
    width="2400"
    height="1600"
    fetchpriority="high"
  />
  <div class="page-hero__veil absolute inset-0" aria-hidden="true"></div>
  <div class="page-hero__fade pointer-events-none absolute inset-x-0 bottom-0 h-24 md:h-28" aria-hidden="true"
  ></div>

  <div
    class:list={[
      'site-shell relative z-10 w-full',
      compact ? 'pb-14 pt-32 md:pb-20 md:pt-40' : 'pb-20 pt-36 md:pb-28 md:pt-44',
    ]}
  >
    {
      eyebrow && (
        <p class="reveal type-eyebrow text-or">{eyebrow}</p>
      )
    }
    <h1
      class:list={[
        'reveal reveal-delay-1 mt-5 max-w-5xl',
        compact ? 'page-hero__title type-display' : 'type-display-lg',
      ]}
    >
      {title}
    </h1>
    <div class="reveal reveal-delay-2 gold-rule mt-7"></div>
    {
      sub && (
        <p class="reveal reveal-delay-2 type-lead mt-6 max-w-2xl text-ivoire/80">{sub}</p>
      )
    }
    <div class="reveal reveal-delay-3 mt-2">
      <slot />
    </div>
  </div>
</section>

<style>
  .page-hero--compact {
    min-height: clamp(18rem, 42svh, 26rem);
  }

  .page-hero--tall {
    min-height: 92vh;
  }

  .page-hero__media--compact {
    object-position: center 42%;
  }

  .page-hero__veil {
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--color-azur-profond) 78%, transparent) 0%,
      color-mix(in srgb, var(--color-azur-profond) 42%, transparent) 38%,
      color-mix(in srgb, var(--color-azur-profond) 58%, transparent) 68%,
      color-mix(in srgb, var(--color-azur-profond) 94%, transparent) 100%
    );
  }

  .page-hero__fade {
    background: linear-gradient(180deg, transparent, var(--color-ivoire));
  }

  .page-hero__title {
    font-size: clamp(2.35rem, 1.55rem + 2.6vw, 4.25rem);
  }
</style>
