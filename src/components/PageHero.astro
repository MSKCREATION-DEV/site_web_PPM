---
interface Props {
  eyebrow?: string;
  title: string;
  sub?: string;
  image: string;
  imageAlt?: string;
  compact?: boolean;
}

const { eyebrow, title, sub, image, imageAlt = '', compact = false } = Astro.props;
---

<section
  class:list={[
    'relative flex items-end overflow-hidden bg-nuit text-ivoire',
    compact ? 'min-h-[52vh]' : 'min-h-[92vh]',
  ]}
>
  <img
    src={image}
    alt={imageAlt}
    class="hero-media absolute inset-0 h-full w-full object-cover"
    width="2400"
    height="1600"
    fetchpriority="high"
  />
  <div
    class="absolute inset-0 bg-[linear-gradient(180deg,rgba(13,19,48,0.35)_0%,rgba(13,19,48,0.55)_40%,rgba(13,19,48,0.92)_100%)]"
    aria-hidden="true"
  >
  </div>
  <div class="relative z-10 mx-auto w-full max-w-6xl px-4 pb-16 pt-32 md:px-6 md:pb-24 md:pt-40">
    {
      eyebrow && (
        <p class="reveal text-xs tracking-[0.28em] text-or uppercase md:text-sm">{eyebrow}</p>
      )
    }
    <h1
      class="reveal reveal-delay-1 mt-4 max-w-4xl font-display text-4xl leading-[1.08] md:text-6xl lg:text-7xl"
    >
      {title}
    </h1>
    {
      sub && (
        <p class="reveal reveal-delay-2 mt-5 max-w-xl text-base text-ivoire/80 md:text-lg">{sub}</p>
      )
    }
    <div class="reveal reveal-delay-3 mt-2">
      <slot />
    </div>
  </div>
</section>
