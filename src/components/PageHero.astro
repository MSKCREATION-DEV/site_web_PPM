---
interface Props {
  eyebrow?: string;
  title: string;
  sub?: string;
  image: string;
  imageAlt?: string;
  compact?: boolean;
}

const { eyebrow, title, sub, image, imageAlt = '', compact = false } = Astro.props;
---

<section
  data-nav="dark"
  class:list={[
    'relative flex items-end overflow-hidden bg-nuit text-ivoire',
    compact ? 'min-h-[52vh]' : 'min-h-[92vh]',
  ]}
>
  <img
    src={image}
    alt={imageAlt}
    class="hero-media absolute inset-0 h-full w-full object-cover"
    width="2400"
    height="1600"
    fetchpriority="high"
  />
  <div
    class="absolute inset-0 bg-[linear-gradient(180deg,rgba(18,63,112,0.35)_0%,rgba(18,63,112,0.55)_40%,rgba(18,63,112,0.92)_100%)]"
    aria-hidden="true"
  >
  </div>
  <div class="site-shell relative z-10 w-full pb-20 pt-36 md:pb-28 md:pt-44">
    {
      eyebrow && (
        <p class="reveal type-eyebrow text-or">{eyebrow}</p>
      )
    }
    <h1 class="reveal reveal-delay-1 type-display-lg mt-5 max-w-5xl">
      {title}
    </h1>
    {
      sub && (
        <p class="reveal reveal-delay-2 type-lead mt-6 max-w-2xl text-ivoire/80">{sub}</p>
      )
    }
    <div class="reveal reveal-delay-3 mt-2">
      <slot />
    </div>
  </div>
</section>
