---
import { site, nav } from '../data/site';

const year = new Date().getFullYear();
const waHref = `https://wa.me/${site.contact.whatsappE164}`;
---

<footer data-nav="dark" class="bg-nuit text-ivoire">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-14 md:grid-cols-12 md:gap-8 md:px-6 md:py-16">
    <div class="md:col-span-5">
      <img
        src={site.brandAssets.logoHorizontalBlanc}
        alt={site.brand}
        width="212"
        height="60"
        class="h-10 w-auto"
        loading="lazy"
        decoding="async"
      />
      <p class="mt-4 max-w-sm text-sm leading-relaxed text-ivoire/60">{site.tagline}</p>
      <p class="mt-6 text-xs text-ivoire/40">{site.legalName}</p>
    </div>

    <div class="md:col-span-3">
      <p class="text-[0.7rem] tracking-[0.22em] text-or uppercase">Navigation</p>
      <ul class="mt-4 space-y-2.5 text-sm">
        {
          nav.map((item) => (
            <li>
              <a href={item.href} class="text-ivoire/75 no-underline transition hover:text-or">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="md:col-span-4">
      <p class="text-[0.7rem] tracking-[0.22em] text-or uppercase">Contact</p>
      <ul class="mt-4 space-y-2.5 text-sm text-ivoire/75">
        <li>
          <a href={`tel:+${site.contact.phoneE164}`} class="no-underline transition hover:text-or">
            {site.contact.phoneDisplay}
          </a>
        </li>
        <li>
          <a href={`mailto:${site.contact.email}`} class="no-underline transition hover:text-or">
            {site.contact.email}
          </a>
        </li>
        <li>{site.contact.addressLine}, {site.contact.country}</li>
        <li class="flex flex-wrap gap-x-3 gap-y-1 pt-1">
          <a href={waHref} class="no-underline transition hover:text-or" target="_blank" rel="noopener noreferrer">
            WhatsApp
          </a>
          <a
            href={site.social.facebook}
            class="no-underline transition hover:text-or"
            target="_blank"
            rel="noopener noreferrer"
          >
            Facebook
          </a>
          <a
            href={site.social.instagram}
            class="no-underline transition hover:text-or"
            target="_blank"
            rel="noopener noreferrer"
          >
            Instagram
          </a>
        </li>
      </ul>
    </div>
  </div>

  <!-- Crédit : « Design by » + SVG complet (logo + MSK CREATION déjà dans le fichier) -->
  <div class="border-t border-ivoire/10">
    <div
      class="mx-auto flex max-w-6xl flex-col items-start justify-between gap-4 px-4 py-4 text-xs text-ivoire/45 sm:flex-row sm:items-center md:px-6"
    >
      <p>© {year} {site.brand}. Tous droits réservés.</p>
      <a
        href={site.msk.url}
        class="inline-flex items-center gap-2.5 text-ivoire/50 no-underline transition hover:opacity-100 hover:brightness-110"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Design by MSK CREATION"
      >
        <span class="text-ivoire/45">Design by</span>
        <img
          src={site.msk.logoSrc}
          alt="MSK CREATION"
          width="160"
          height="24"
          class="h-6 w-auto max-w-[160px] object-contain object-left"
          loading="lazy"
        />
      </a>
    </div>
  </div>
</footer>
