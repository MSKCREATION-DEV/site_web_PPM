---
import { nav, site } from '../data/site';

const pathname = Astro.url.pathname;
const { logoHorizontalBlanc, logoHorizontalClair } = site.brandAssets;
---

<header
  id="site-header"
  class="site-header fixed inset-x-0 top-0 z-50"
  data-theme="dark"
  data-scrolled="false"
>
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-4 md:px-6 md:py-5">
    <a href="/" class="group relative z-10 flex shrink-0 no-underline" aria-label={site.brand}>
      <img
        src={logoHorizontalBlanc}
        alt={site.brand}
        width="212"
        height="60"
        class="nav-logo nav-logo--dark h-9 w-auto md:h-10"
        decoding="async"
      />
      <img
        src={logoHorizontalClair}
        alt=""
        width="212"
        height="60"
        class="nav-logo nav-logo--light h-9 w-auto md:h-10"
        decoding="async"
        aria-hidden="true"
      />
    </a>

    <nav aria-label="Principale" class="hidden items-center gap-8 text-[0.8rem] tracking-[0.14em] uppercase md:flex">
      {
        nav.map((item) => {
          const active =
            item.href === '/' ? pathname === '/' : pathname.startsWith(item.href);
          return (
            <a
              href={item.href}
              class:list={['nav-link relative no-underline', active && 'is-active']}
              aria-current={active ? 'page' : undefined}
            >
              {item.label}
            </a>
          );
        })
      }
    </nav>

    <div class="flex items-center gap-3">
      <a
        href="/contact"
        class="nav-cta hidden rounded-sm bg-or px-4 py-2.5 text-xs font-medium tracking-wide text-blanc no-underline transition hover:brightness-110 sm:inline-block"
      >
        Demander un devis
      </a>
      <button
        type="button"
        id="nav-toggle"
        class="nav-toggle flex h-10 w-10 items-center justify-center md:hidden"
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label="Ouvrir le menu"
      >
        <span class="sr-only">Menu</span>
        <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-width="1.5" d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-nav" class="nav-mobile hidden border-t px-4 py-6 md:hidden">
    <ul class="flex flex-col gap-4 text-sm tracking-wide">
      {
        nav.map((item) => (
          <li>
            <a href={item.href} class="nav-link block py-1 no-underline">
              {item.label}
            </a>
          </li>
        ))
      }
      <li>
        <a href="/contact" class="nav-cta mt-2 inline-block rounded-sm bg-or px-4 py-2 text-blanc no-underline">
          Demander un devis
        </a>
      </li>
    </ul>
  </div>
</header>

<script>
  const toggle = document.getElementById('nav-toggle');
  const mobile = document.getElementById('mobile-nav');

  toggle?.addEventListener('click', () => {
    const open = mobile?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(open));
  });
</script>

<style>
  .site-header {
    --nav-fg: var(--color-craie);
    --nav-fg-muted: color-mix(in srgb, var(--color-craie) 82%, transparent);
    --nav-bg: transparent;
    background-color: var(--nav-bg);
    transition:
      background-color 0.3s ease,
      color 0.3s ease;
  }

  .site-header[data-theme='dark'] {
    --nav-fg: var(--color-craie);
    --nav-fg-muted: color-mix(in srgb, var(--color-craie) 82%, transparent);
  }

  .site-header[data-theme='light'] {
    --nav-fg: var(--color-azur-profond);
    --nav-fg-muted: color-mix(in srgb, var(--color-azur-profond) 72%, transparent);
  }

  .nav-logo {
    display: block;
    object-fit: contain;
    object-position: left center;
  }

  .nav-logo--light {
    display: none;
  }

  .site-header[data-theme='light'] .nav-logo--dark {
    display: none;
  }

  .site-header[data-theme='light'] .nav-logo--light {
    display: block;
  }

  .nav-link {
    color: var(--nav-fg-muted);
    transition: color 0.3s ease;
  }

  .nav-link:hover,
  .nav-link.is-active {
    color: var(--color-or);
  }

  .site-header[data-theme='light'] .nav-link:hover,
  .site-header[data-theme='light'] .nav-link.is-active {
    color: var(--color-azur);
  }

  .nav-toggle {
    color: var(--nav-fg);
    transition: color 0.3s ease;
  }

  .nav-mobile {
    background-color: var(--nav-bg);
    border-color: color-mix(in srgb, var(--nav-fg) 12%, transparent);
    color: var(--nav-fg);
  }

  .site-header[data-theme='light'] .nav-cta {
    background-color: var(--color-azur-profond);
  }
</style>
