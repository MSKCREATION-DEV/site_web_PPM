---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFab from '../components/WhatsAppFab.astro';
import { site } from '../data/site';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = `${site.brand}. Billetterie, voyages et pèlerinage à Bamako.`,
} = Astro.props;

const pageTitle = title.includes('Prosperity') ? title : `${title} · ${site.brand}`;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#123F70" />
    <link rel="icon" type="image/png" href={site.brandAssets.embleme} />
    <link rel="apple-touch-icon" href={site.brandAssets.embleme} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,500&family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;1,9..40,400&display=swap"
      rel="stylesheet"
    />
    <title>{pageTitle}</title>
  </head>
  <body class="min-h-screen flex flex-col bg-blanc text-nuit">
    <a
      href="#contenu"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:bg-or focus:px-4 focus:py-2 focus:text-blanc"
    >
      Aller au contenu
    </a>

    <Header />

    <main id="contenu" class="flex-1">
      <slot />
    </main>

    <Footer />
    <WhatsAppFab />

    <script>
      import '../scripts/motion.ts';
    </script>
  </body>
</html>
