---
import BaseLayout from '../layouts/BaseLayout.astro';
import { contactPage } from '../data/content';
import { site } from '../data/site';

const waHref = `https://wa.me/${site.contact.whatsappE164}`;
---

<BaseLayout
  title="Contact"
  description={`Contact ${site.brand} à Bamako. Formulaire, WhatsApp, téléphone et carte.`}
>
  <section class="bg-nuit pt-28 pb-16 text-ivoire md:pt-36 md:pb-20">
    <div class="mx-auto max-w-6xl px-4 md:px-6">
      <p class="reveal text-xs tracking-[0.28em] text-or uppercase">{contactPage.hero.eyebrow}</p>
      <h1 class="reveal reveal-delay-1 mt-4 max-w-3xl font-display text-4xl md:text-6xl">
        {contactPage.hero.title}
      </h1>
      <p class="reveal reveal-delay-2 mt-5 max-w-xl text-ivoire/70">{contactPage.hero.sub}</p>
    </div>
  </section>

  <section class="bg-ivoire py-16 md:py-24">
    <div class="mx-auto grid max-w-6xl gap-14 px-4 lg:grid-cols-2 md:px-6">
      <form class="reveal space-y-5" method="post" action="#" aria-label="Formulaire de contact">
        <div>
          <label for="nom" class="block text-sm font-medium">Nom</label>
          <input
            id="nom"
            name="nom"
            required
            class="mt-1.5 w-full border border-nuit/15 bg-white px-3 py-3 text-nuit outline-none transition focus:border-or"
          />
        </div>
        <div>
          <label for="email" class="block text-sm font-medium">E-mail</label>
          <input
            id="email"
            name="email"
            type="email"
            required
            class="mt-1.5 w-full border border-nuit/15 bg-white px-3 py-3 text-nuit outline-none transition focus:border-or"
          />
        </div>
        <div>
          <label for="telephone" class="block text-sm font-medium">Téléphone</label>
          <input
            id="telephone"
            name="telephone"
            type="tel"
            class="mt-1.5 w-full border border-nuit/15 bg-white px-3 py-3 text-nuit outline-none transition focus:border-or"
          />
        </div>
        <div>
          <label for="sujet" class="block text-sm font-medium">Sujet</label>
          <select
            id="sujet"
            name="sujet"
            class="mt-1.5 w-full border border-nuit/15 bg-white px-3 py-3 text-nuit outline-none transition focus:border-or"
          >
            <option>Billetterie / Voyage</option>
            <option>Pèlerinage</option>
            <option>Autre demande</option>
          </select>
        </div>
        <div>
          <label for="message" class="block text-sm font-medium">Message</label>
          <textarea
            id="message"
            name="message"
            rows="5"
            required
            class="mt-1.5 w-full border border-nuit/15 bg-white px-3 py-3 text-nuit outline-none transition focus:border-or"
          ></textarea>
        </div>
        <button
          type="submit"
          class="rounded-sm bg-or px-7 py-3.5 text-sm font-medium text-nuit transition hover:brightness-110"
        >
          Envoyer la demande
        </button>
        <p class="text-xs text-nuit/45">Le formulaire sera branché sur un envoi sécurisé avant la mise en ligne.</p>
      </form>

      <aside class="reveal reveal-delay-2 space-y-10 text-sm">
        <div>
          <h2 class="font-display text-2xl">Coordonnées</h2>
          <ul class="mt-4 space-y-2.5 text-nuit/75">
            <li>
              Tél. :
              <a href={`tel:+${site.contact.phoneE164}`} class="hover:text-or">{site.contact.phoneDisplay}</a>
              / {site.contact.phoneAltDisplay}
            </li>
            <li>
              E-mail :
              <a href={`mailto:${site.contact.email}`} class="hover:text-or">{site.contact.email}</a>
            </li>
            <li>Adresse : {site.contact.addressLine}, {site.contact.country}</li>
            <li>Horaires : {site.contact.hours}</li>
          </ul>
        </div>

        <div>
          <h2 class="font-display text-2xl">WhatsApp</h2>
          <a
            href={waHref}
            class="mt-3 inline-block text-or no-underline hover:underline"
            target="_blank"
            rel="noopener noreferrer"
          >
            Écrire sur WhatsApp →
          </a>
        </div>

        <div>
          <h2 class="font-display text-2xl">Réseaux</h2>
          <ul class="mt-3 flex gap-5">
            <li>
              <a href={site.social.facebook} class="text-or no-underline hover:underline" target="_blank" rel="noopener noreferrer">
                Facebook
              </a>
            </li>
            <li>
              <a href={site.social.instagram} class="text-or no-underline hover:underline" target="_blank" rel="noopener noreferrer">
                Instagram
              </a>
            </li>
          </ul>
        </div>

        <div>
          <h2 class="font-display text-2xl">Localisation</h2>
          <div class="mt-4 aspect-video w-full overflow-hidden border border-nuit/10">
            <iframe
              title="Carte — localisation provisoire Bamako"
              src={site.contact.mapsEmbedUrl}
              class="h-full w-full border-0"
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              allowfullscreen
            ></iframe>
          </div>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>
