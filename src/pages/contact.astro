---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactHero from '../components/ContactHero.astro';
import { contactPage } from '../data/content';
import { site } from '../data/site';

const waHref = `https://wa.me/${site.contact.whatsappE164}`;

const channels = [
  {
    label: 'Téléphone',
    value: site.contact.phoneDisplay,
    href: `tel:+${site.contact.phoneE164}`,
    hint: site.contact.phoneAltDisplay,
  },
  {
    label: 'E-mail',
    value: site.contact.email,
    href: `mailto:${site.contact.email}`,
  },
  {
    label: 'Adresse',
    value: `${site.contact.addressLine}, ${site.contact.country}`,
    href: site.contact.mapsLink,
  },
] as const;
---

<BaseLayout
  title="Contact"
  description={`Contact ${site.brand} à Bamako. Formulaire, WhatsApp, téléphone et carte.`}
>
  <ContactHero
    eyebrow={contactPage.hero.eyebrow}
    title={contactPage.hero.title}
    sub={contactPage.hero.sub}
    image={contactPage.hero.image}
    imageAlt={contactPage.hero.imageAlt}
    whatsappHref={waHref}
    formHref="#formulaire"
  />

  <!-- Horaires — bande éditoriale -->
  <section data-nav="light" class="border-y border-nuit/8 bg-blanc">
    <div class="site-shell grid md:grid-cols-2">
      <div class="reveal border-b border-nuit/8 py-12 md:border-b-0 md:border-r md:py-16 md:pr-12">
        <p class="type-eyebrow text-or">Bureau</p>
        <p class="type-title mt-3 text-nuit">{site.contact.hours}</p>
      </div>
      <div class="reveal reveal-delay-1 py-12 md:py-16 md:pl-12">
        <p class="type-eyebrow text-or">Billetterie</p>
        <p class="type-title mt-3 text-nuit">{site.contact.hoursTickets}</p>
      </div>
    </div>
  </section>

  <!-- Formulaire + canaux -->
  <section id="formulaire" data-nav="light" class="contact-form-anchor section-pad bg-ivoire">
    <div class="site-shell grid gap-16 lg:grid-cols-12 lg:gap-24">
      <div class="reveal lg:col-span-7">
        <div class="gold-rule"></div>
        <h2 class="type-display mt-6">Envoyer une demande</h2>
        <p class="type-lead mt-4 max-w-xl text-nuit/65">
          Indiquez votre besoin. On vous rappelle depuis Bamako.
        </p>

        <form class="mt-12 space-y-8" method="post" action="#" aria-label="Formulaire de contact">
          <div class="grid gap-8 sm:grid-cols-2">
            <div>
              <label for="nom" class="text-[0.7rem] tracking-[0.18em] text-nuit/50 uppercase">Nom</label>
              <input id="nom" name="nom" required class="field-line mt-1" autocomplete="name" />
            </div>
            <div>
              <label for="telephone" class="text-[0.7rem] tracking-[0.18em] text-nuit/50 uppercase">
                Téléphone
              </label>
              <input id="telephone" name="telephone" type="tel" class="field-line mt-1" autocomplete="tel" />
            </div>
          </div>
          <div>
            <label for="email" class="text-[0.7rem] tracking-[0.18em] text-nuit/50 uppercase">E-mail</label>
            <input id="email" name="email" type="email" required class="field-line mt-1" autocomplete="email" />
          </div>
          <div>
            <label for="sujet" class="text-[0.7rem] tracking-[0.18em] text-nuit/50 uppercase">Sujet</label>
            <select id="sujet" name="sujet" class="field-line mt-1">
              <option>Billetterie aérienne</option>
              <option>Hadj</option>
              <option>Umrah</option>
              <option>Visa Hadj / Umrah</option>
              <option>Réservation d’hôtels</option>
              <option>Autre demande</option>
            </select>
          </div>
          <div>
            <label for="message" class="text-[0.7rem] tracking-[0.18em] text-nuit/50 uppercase">Message</label>
            <textarea id="message" name="message" rows="4" required class="field-line mt-1 resize-y"></textarea>
          </div>
          <div class="flex flex-wrap items-center gap-4 pt-2">
            <button
              type="submit"
              class="rounded-sm bg-azur-profond px-8 py-3.5 text-sm font-medium text-blanc transition hover:bg-azur"
            >
              Envoyer la demande
            </button>
            <p class="text-xs text-nuit/40">Envoi sécurisé à brancher avant la mise en ligne.</p>
          </div>
        </form>
      </div>

      <aside class="reveal reveal-delay-2 lg:col-span-5">
        <p class="text-[0.7rem] tracking-[0.22em] text-or uppercase">Coordonnées</p>
        <ul class="mt-8 divide-y divide-nuit/10 border-y border-nuit/10">
          {
            channels.map((c) => (
              <li>
                <a
                  href={c.href}
                  class="group flex flex-col gap-1 py-5 no-underline transition"
                  target={c.href.startsWith('http') ? '_blank' : undefined}
                  rel={c.href.startsWith('http') ? 'noopener noreferrer' : undefined}
                >
                  <span class="text-[0.7rem] tracking-[0.16em] text-nuit/45 uppercase">{c.label}</span>
                  <span class="font-display text-xl text-nuit transition group-hover:text-azur md:text-2xl">
                    {c.value}
                  </span>
                  {'hint' in c && c.hint ? (
                    <span class="text-sm text-nuit/50">{c.hint}</span>
                  ) : null}
                </a>
              </li>
            ))
          }
        </ul>

        <a
          href={waHref}
          class="mt-8 flex items-center justify-between gap-4 border border-or/40 bg-nuit px-5 py-5 text-ivoire no-underline transition hover:border-or"
          target="_blank"
          rel="noopener noreferrer"
        >
          <span>
            <span class="block text-[0.7rem] tracking-[0.18em] text-or uppercase">WhatsApp</span>
            <span class="mt-1 block font-display text-xl">Écrire maintenant</span>
          </span>
          <span class="text-or" aria-hidden="true">→</span>
        </a>

        <div class="mt-8 flex gap-6 text-sm">
          <a
            href={site.social.facebook}
            class="text-nuit/60 no-underline transition hover:text-azur"
            target="_blank"
            rel="noopener noreferrer"
          >
            Facebook
          </a>
          <a
            href={site.social.instagram}
            class="text-nuit/60 no-underline transition hover:text-azur"
            target="_blank"
            rel="noopener noreferrer"
          >
            Instagram
          </a>
        </div>
      </aside>
    </div>
  </section>

  <!-- Carte fondue -->
  <section data-nav="light" class="relative bg-ivoire pb-0">
    <div class="site-shell">
      <div class="reveal flex items-end justify-between gap-4 pb-6">
        <div>
          <p class="type-eyebrow text-or">Localisation</p>
          <h2 class="type-title mt-3">Bamako</h2>
        </div>
        <a
          href={site.contact.mapsLink}
          class="text-sm text-azur no-underline hover:underline"
          target="_blank"
          rel="noopener noreferrer"
        >
          Ouvrir dans Maps →
        </a>
      </div>
    </div>
    <div class="relative h-[42vh] min-h-[280px] w-full overflow-hidden md:h-[48vh]">
      <iframe
        title="Carte — localisation provisoire Bamako"
        src={site.contact.mapsEmbedUrl}
        class="absolute inset-0 h-full w-full border-0 grayscale-[30%] contrast-[1.05]"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        allowfullscreen
      ></iframe>
      <div
        class="pointer-events-none absolute inset-x-0 top-0 h-24 bg-gradient-to-b from-ivoire to-transparent"
        aria-hidden="true"
      >
      </div>
    </div>
  </section>
</BaseLayout>
