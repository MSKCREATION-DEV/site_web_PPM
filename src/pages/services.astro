---
import BaseLayout from '../layouts/BaseLayout.astro';
import { services } from '../data/content';
---

<BaseLayout
  title="Nos services"
  description="Billetterie aérienne, Hadj, Omra, visa et hôtels avec Prosperity Travel à Bamako."
>
  <!-- Intro -->
  <header data-nav="dark" class="bg-nuit pt-28 pb-8 text-ivoire md:pt-36 md:pb-10">
    <div class="mx-auto max-w-6xl px-4 md:px-6">
      <p class="reveal text-xs tracking-[0.28em] text-or uppercase">{services.hero.eyebrow}</p>
      <h1 class="reveal reveal-delay-1 mt-3 max-w-3xl font-display text-4xl leading-snug md:text-6xl">
        {services.hero.title}
      </h1>
      <p class="reveal reveal-delay-2 mt-5 max-w-xl text-ivoire/70 md:text-lg">{services.hero.sub}</p>

      <nav aria-label="Sommaire des services" class="reveal reveal-delay-3 mt-10 flex flex-wrap gap-2 border-t border-ivoire/15 pt-6">
        {
          services.blocks.map((b) => (
            <a
              href={`#${b.id}`}
              class="rounded-sm border border-ivoire/15 px-3 py-2 text-[0.7rem] tracking-[0.1em] text-ivoire/70 uppercase no-underline transition hover:border-or/50 hover:text-or"
            >
              <span class="text-or">{b.eyebrow}</span>
              <span class="ml-1.5">{b.title}</span>
            </a>
          ))
        }
      </nav>
    </div>
  </header>

  <!-- Bandes 50/50 — même forme panneau adouci pour toutes les images -->
  {
    services.blocks.map((block, index) => {
      const dark = index % 2 === 1;
      const imageFirst = index % 2 === 0;
      const maskId = `svc-mask-${block.id}`;
      const filterId = `svc-soft-${block.id}`;

      return (
        <section
          id={block.id}
          data-nav={dark ? 'dark' : 'light'}
          class:list={['scroll-mt-24', dark ? 'bg-nuit text-ivoire' : 'bg-ivoire text-nuit']}
        >
          <div class="mx-auto grid max-w-6xl items-center md:grid-cols-2 md:min-h-[min(72vh,720px)]">
            <div
              class:list={[
                'flex items-center justify-center px-3 py-10 md:px-4 md:py-12 lg:px-6',
                imageFirst ? 'order-1' : 'order-1 md:order-2',
              ]}
            >
              <div class="service-frame reveal">
                <svg
                  class="service-frame__svg"
                  viewBox="0 0 460 520"
                  role="img"
                  aria-label={block.imageAlt ?? block.title}
                >
                  <defs>
                    <filter id={filterId} x="-5%" y="-5%" width="110%" height="110%">
                      <feGaussianBlur stdDeviation="8" />
                    </filter>
                    <mask id={maskId}>
                      <g filter={`url(#${filterId})`}>
                        <rect x="20" y="20" width="420" height="480" rx="36" ry="36" fill="#fff" />
                      </g>
                    </mask>
                  </defs>
                  <image
                    href={block.image}
                    width="460"
                    height="520"
                    preserveAspectRatio="xMidYMid slice"
                    mask={`url(#${maskId})`}
                  />
                </svg>
              </div>
            </div>

            <div
              class:list={[
                'flex items-center px-4 py-10 md:px-12 md:py-16 lg:px-16',
                imageFirst ? 'order-2' : 'order-2 md:order-1',
              ]}
            >
              <div class="reveal w-full max-w-md">
                <p class="font-mono text-xs tracking-[0.28em] text-or">{block.eyebrow}</p>
                <h2 class="mt-3 font-display text-3xl leading-tight md:text-4xl lg:text-[2.75rem]">
                  {block.title}
                </h2>
                <div class="gold-rule mt-6"></div>
                <p
                  class:list={[
                    'mt-6 text-base leading-relaxed md:text-lg',
                    dark ? 'text-ivoire/70' : 'text-nuit/70',
                  ]}
                >
                  {block.text}
                </p>
                <ul class="mt-8 space-y-3">
                  {block.points.map((point) => (
                    <li class="flex items-center gap-4 text-sm md:text-base">
                      <span class="h-px w-7 shrink-0 bg-or" aria-hidden="true" />
                      {point}
                    </li>
                  ))}
                </ul>
                <a
                  href="/contact"
                  class:list={[
                    'mt-10 inline-block rounded-sm px-7 py-3.5 text-sm font-medium no-underline transition',
                    dark
                      ? 'bg-or text-blanc hover:brightness-110'
                      : 'bg-azur-profond text-blanc hover:bg-azur',
                  ]}
                >
                  Demander un devis
                </a>
              </div>
            </div>
          </div>
        </section>
      );
    })
  }

  <!-- CTA -->
  <section data-nav="light" class="border-t border-nuit/5 bg-ivoire py-20 text-center md:py-28">
    <div class="reveal mx-auto max-w-xl px-4">
      <div class="gold-rule mx-auto"></div>
      <h2 class="mt-8 font-display text-3xl text-nuit md:text-4xl">Un départ à préparer ?</h2>
      <p class="mt-4 text-nuit/65">Bureau 8h–17h · réservation de billets 24h/24.</p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a
          href="/contact"
          class="rounded-sm bg-azur-profond px-7 py-3.5 text-sm font-medium text-blanc no-underline transition hover:bg-azur"
        >
          Nous contacter
        </a>
        <a
          href="/contact#formulaire"
          class="rounded-sm border border-nuit/20 px-7 py-3.5 text-sm text-nuit no-underline transition hover:border-azur hover:text-azur"
        >
          Demander un devis
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
