---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { services } from '../data/content';
---

<BaseLayout
  title="Nos services"
  description="Billetterie aérienne, voyages et organisation de pèlerinage avec Prosperity Travel à Bamako."
>
  <PageHero
    eyebrow={services.hero.eyebrow}
    title={services.hero.title}
    sub={services.hero.sub}
    image={services.hero.image}
    imageAlt="Aéroport — départ"
    compact
  />

  {
    services.blocks.map((block, index) => (
      <section
        id={block.id}
        class:list={['scroll-mt-24 py-20 md:py-28', index % 2 === 0 ? 'bg-ivoire' : 'bg-nuit text-ivoire']}
      >
        <div class="mx-auto grid max-w-6xl items-center gap-12 px-4 md:grid-cols-2 md:gap-16 md:px-6">
          <div class:list={['reveal', index % 2 === 1 && 'md:order-2']}>
            <p class="font-mono text-xs tracking-[0.25em] text-or">{block.eyebrow}</p>
            <h2 class="mt-3 font-display text-3xl md:text-4xl">{block.title}</h2>
            <p
              class:list={[
                'mt-5 text-base leading-relaxed md:text-lg',
                index % 2 === 0 ? 'text-nuit/70' : 'text-ivoire/70',
              ]}
            >
              {block.text}
            </p>
            <ul class="mt-8 space-y-3">
              {block.points.map((point) => (
                <li class="flex items-start gap-3 text-sm">
                  <span class="mt-1.5 h-px w-6 shrink-0 bg-or" aria-hidden="true" />
                  {point}
                </li>
              ))}
            </ul>
            <a
              href="/contact"
              class:list={[
                'mt-10 inline-block rounded-sm px-6 py-3 text-sm font-medium no-underline transition',
                index % 2 === 0
                  ? 'bg-or text-blanc hover:brightness-110'
                  : 'border border-ivoire/40 text-ivoire hover:border-or hover:text-or',
              ]}
            >
              Demander un devis
            </a>
          </div>
          <div class:list={['reveal reveal-delay-2 group overflow-hidden', index % 2 === 1 && 'md:order-1']}>
            <div class="aspect-[4/3] overflow-hidden">
              <img
                src={block.image}
                alt={block.title}
                class="img-zoom h-full w-full object-cover"
                width="1000"
                height="750"
                loading="lazy"
              />
            </div>
          </div>
        </div>
      </section>
    ))
  }
</BaseLayout>
