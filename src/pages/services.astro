---
import BaseLayout from '../layouts/BaseLayout.astro';
import { services } from '../data/content';
---

<BaseLayout
  title="Nos services"
  description="Billetterie aérienne, Hadj, Umrah, visa et hôtels avec Prosperity Travel à Bamako."
>
  <header data-nav="dark" class="bg-nuit pt-32 pb-14 text-ivoire md:pt-40 md:pb-20">
    <div class="site-shell">
      <p class="reveal type-eyebrow text-or">{services.hero.eyebrow}</p>
      <h1 class="reveal reveal-delay-1 type-display-lg mt-4 max-w-5xl leading-snug">
        {services.hero.title}
      </h1>
      <p class="reveal reveal-delay-2 type-lead mt-6 max-w-3xl text-ivoire/70">{services.hero.sub}</p>

      <!-- Sommaire : ligne numérotée pleine largeur, sans cases vides -->
      <nav
        aria-label="Sommaire des services"
        class="reveal reveal-delay-3 mt-12 border-t border-ivoire/15 pt-8"
      >
        <ul class="services-toc flex flex-col gap-0 md:flex-row md:items-stretch">
          {
            services.blocks.map((b, i) => (
              <li
                class:list={[
                  'flex-1 border-ivoire/15 md:border-l',
                  i === 0 && 'md:border-l-0',
                  'border-b md:border-b-0',
                ]}
              >
                <a
                  href={`#${b.id}`}
                  class="group flex items-baseline gap-4 py-4 no-underline transition md:flex-col md:gap-3 md:px-5 md:py-2 lg:px-6"
                >
                  <span class="font-mono text-sm tracking-[0.22em] text-or transition group-hover:text-blanc md:text-base">
                    {b.eyebrow}
                  </span>
                  <span class="type-body font-display text-lg leading-snug text-ivoire/90 transition group-hover:text-or md:text-xl lg:text-[1.35rem]">
                    {b.title}
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </header>

  {
    services.blocks.map((block, index) => {
      const dark = index % 2 === 1;
      const imageFirst = index % 2 === 0;
      const maskId = `svc-mask-${block.id}`;
      const filterId = `svc-soft-${block.id}`;

      return (
        <section
          id={block.id}
          data-nav={dark ? 'dark' : 'light'}
          class:list={['scroll-mt-28', dark ? 'bg-nuit text-ivoire' : 'bg-ivoire text-nuit']}
        >
          <div class="site-shell grid items-center md:grid-cols-2 md:min-h-[min(72vh,800px)] md:gap-10 lg:gap-14">
            <div
              class:list={[
                'flex items-center justify-center py-12 md:py-16',
                imageFirst ? 'order-1' : 'order-1 md:order-2',
              ]}
            >
              <div class="service-frame reveal w-full">
                <svg
                  class="service-frame__svg"
                  viewBox="0 0 460 520"
                  role="img"
                  aria-label={block.imageAlt ?? block.title}
                >
                  <defs>
                    <filter id={filterId} x="-5%" y="-5%" width="110%" height="110%">
                      <feGaussianBlur stdDeviation="8" />
                    </filter>
                    <mask id={maskId}>
                      <g filter={`url(#${filterId})`}>
                        <rect x="20" y="20" width="420" height="480" rx="36" ry="36" fill="#fff" />
                      </g>
                    </mask>
                  </defs>
                  <image
                    href={block.image}
                    width="460"
                    height="520"
                    preserveAspectRatio="xMidYMid slice"
                    mask={`url(#${maskId})`}
                  />
                </svg>
              </div>
            </div>

            <div
              class:list={[
                'flex items-center py-12 md:py-20',
                imageFirst ? 'order-2' : 'order-2 md:order-1',
              ]}
            >
              <div class="reveal w-full max-w-2xl">
                <p class="font-mono text-sm tracking-[0.28em] text-or">{block.eyebrow}</p>
                <h2 class="type-display mt-4 leading-tight">{block.title}</h2>
                <div class="gold-rule mt-7"></div>
                <p
                  class:list={[
                    'type-lead mt-7',
                    dark ? 'text-ivoire/70' : 'text-nuit/70',
                  ]}
                >
                  {block.text}
                </p>
                <ul class="mt-10 space-y-4">
                  {block.points.map((point) => (
                    <li class="type-body flex items-center gap-4">
                      <span class="h-px w-8 shrink-0 bg-or" aria-hidden="true" />
                      {point}
                    </li>
                  ))}
                </ul>
                <a
                  href="/contact"
                  class:list={[
                    'btn-lg mt-12 inline-block rounded-sm font-medium no-underline transition',
                    dark
                      ? 'bg-or text-blanc hover:brightness-110'
                      : 'bg-azur-profond text-blanc hover:bg-azur',
                  ]}
                >
                  Demander un devis
                </a>
              </div>
            </div>
          </div>
        </section>
      );
    })
  }

  <section data-nav="light" class="section-pad border-t border-nuit/5 bg-ivoire text-center">
    <div class="site-shell reveal text-center">
      <div class="mx-auto max-w-2xl">
        <div class="gold-rule mx-auto"></div>
        <h2 class="type-display mt-8 text-nuit">Un départ à préparer ?</h2>
        <p class="type-lead mt-5 text-nuit/65">Bureau 8h–17h · réservation de billets 24h/24.</p>
        <div class="mt-10 flex flex-wrap justify-center gap-4">
          <a
            href="/contact"
            class="btn-lg rounded-sm bg-azur-profond font-medium text-blanc no-underline transition hover:bg-azur"
          >
            Nous contacter
          </a>
          <a
            href="/contact#formulaire"
            class="btn-lg rounded-sm border border-nuit/20 text-nuit no-underline transition hover:border-azur hover:text-azur"
          >
            Demander un devis
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
