---
import BaseLayout from '../layouts/BaseLayout.astro';
import { home } from '../data/content';
import { site } from '../data/site';

const waHref = `https://wa.me/${site.contact.whatsappE164}`;
const { hero, manifesto, destinations, experiences, journeys, cta } = home;
---

<BaseLayout
  title="Accueil"
  description="Prosperity Travel à Bamako. Billets d’avion, organisation de voyages et pèlerinage."
>
  <!-- Hero immersif validé + polish gradient -->
  <section data-nav="dark" class="relative flex min-h-[100svh] items-end overflow-hidden bg-nuit text-ivoire">
    <img
      src={hero.image}
      alt={hero.imageAlt}
      class="hero-media absolute inset-0 h-full w-full object-cover"
      width="2000"
      height="1493"
      fetchpriority="high"
    />
    <div
      class="absolute inset-0 bg-[linear-gradient(105deg,rgba(18,63,112,0.82)_0%,rgba(18,63,112,0.42)_48%,rgba(18,63,112,0.78)_100%)]"
      aria-hidden="true"
    >
    </div>
    <div class="relative z-10 mx-auto w-full max-w-6xl px-4 pb-20 pt-36 md:px-6 md:pb-28">
      <img
        src={site.brandAssets.logoHorizontalBlanc}
        alt={site.brand}
        width="320"
        height="90"
        class="reveal h-12 w-auto md:h-16"
        decoding="async"
      />
      <p class="reveal reveal-delay-1 mt-8 max-w-xl font-display text-3xl leading-snug md:text-5xl lg:text-6xl">
        {hero.headline}
      </p>
      <p class="reveal reveal-delay-2 mt-4 max-w-lg text-base text-ivoire/75 md:text-lg">{hero.sub}</p>
      <div class="reveal reveal-delay-3 mt-10 flex flex-wrap gap-3">
        <a
          href={hero.ctaPrimary.href}
          class="rounded-sm bg-or px-7 py-3.5 text-sm font-medium text-blanc no-underline transition hover:brightness-110"
        >
          {hero.ctaPrimary.label}
        </a>
        <a
          href={hero.ctaSecondary.href}
          class="rounded-sm border border-ivoire/35 px-7 py-3.5 text-sm text-ivoire no-underline transition hover:border-or hover:text-or"
        >
          {hero.ctaSecondary.label}
        </a>
      </div>
      <p class="reveal reveal-delay-4 mt-12 font-mono text-[0.65rem] tracking-[0.2em] text-ivoire/40">
        {hero.coords}
      </p>
    </div>
  </section>

  <!-- Manifesto -->
  <section data-nav="light" class="bg-ivoire">
    <div class="mx-auto max-w-3xl px-4 py-20 text-center md:px-6 md:py-28">
      <div class="gold-rule mx-auto reveal"></div>
      <p class="reveal mt-8 text-xs tracking-[0.28em] text-or uppercase">{manifesto.eyebrow}</p>
      <h2 class="reveal reveal-delay-1 mt-4 font-display text-3xl leading-snug md:text-5xl">
        {manifesto.title}
      </h2>
      <p class="reveal reveal-delay-2 mt-6 text-base leading-relaxed text-nuit/70 md:text-lg">
        {manifesto.body}
      </p>
    </div>
  </section>

  <!-- Destinations -->
  <section data-nav="dark" class="bg-nuit py-20 text-ivoire md:py-28">
    <div class="mx-auto max-w-6xl px-4 md:px-6">
      <div class="reveal max-w-2xl">
        <p class="text-xs tracking-[0.28em] text-or uppercase">{destinations.eyebrow}</p>
        <h2 class="mt-3 font-display text-3xl md:text-5xl">{destinations.title}</h2>
        <p class="mt-4 text-ivoire/65">{destinations.intro}</p>
      </div>

      <ul class="mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {
          destinations.items.map((item, i) => (
            <li class:list={['reveal', i === 1 && 'reveal-delay-1', i === 2 && 'reveal-delay-2', i === 3 && 'reveal-delay-3']}>
              <a href={item.href} class="group block no-underline">
                <div class="relative aspect-[3/4] overflow-hidden">
                  <img
                    src={item.image}
                    alt={item.name}
                    class="img-zoom h-full w-full object-cover"
                    width="600"
                    height="800"
                    loading="lazy"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-nuit via-nuit/25 to-transparent" />
                  <div class="absolute inset-x-0 bottom-0 p-5">
                    <p class="text-[0.65rem] tracking-[0.2em] text-or uppercase">{item.region}</p>
                    <h3 class="mt-1 font-display text-2xl">{item.name}</h3>
                    <p class="mt-2 text-xs text-ivoire/70 opacity-0 transition duration-500 group-hover:opacity-100">
                      {item.blurb}
                    </p>
                  </div>
                </div>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Expériences — liste -->
  <section data-nav="light" class="bg-ivoire py-20 md:py-28">
    <div class="mx-auto max-w-6xl px-4 md:px-6">
      <div class="reveal">
        <p class="text-xs tracking-[0.28em] text-or uppercase">{experiences.eyebrow}</p>
        <h2 class="mt-3 font-display text-3xl md:text-5xl">{experiences.title}</h2>
      </div>
      <ul class="mt-14 divide-y divide-nuit/10 border-y border-nuit/10">
        {
          experiences.items.map((item, i) => (
            <li class:list={['reveal', `reveal-delay-${(i % 3) + 1}`]}>
              <a
                href={item.href}
                class="group flex flex-col gap-3 py-8 no-underline transition md:flex-row md:items-baseline md:gap-10 md:py-10"
              >
                <span class="font-mono text-xs tracking-widest text-or">{item.id}</span>
                <h3 class="font-display text-2xl text-nuit transition group-hover:text-azur md:w-64 md:shrink-0 md:text-3xl">
                  {item.title}
                </h3>
                <p class="max-w-xl text-sm text-nuit/65 md:text-base">{item.text}</p>
                <span class="ml-auto hidden text-azur transition group-hover:translate-x-1 md:inline">→</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Parcours -->
  <section data-nav="light" class="border-t border-nuit/5 bg-ivoire pb-8 md:pb-12">
    <div class="mx-auto max-w-6xl px-4 md:px-6">
      <div class="reveal mb-10">
        <p class="text-xs tracking-[0.28em] text-or uppercase">{journeys.eyebrow}</p>
        <h2 class="mt-3 font-display text-3xl md:text-4xl">{journeys.title}</h2>
      </div>
      <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          journeys.items.map((item, i) => (
            <li
              class:list={[
                'reveal border-t border-or/60 pt-5',
                i === 1 && 'reveal-delay-1',
                i === 2 && 'reveal-delay-2',
                i === 3 && 'reveal-delay-3',
              ]}
            >
              <h3 class="font-display text-xl">{item.title}</h3>
              <p class="mt-2 text-sm text-nuit/65">{item.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- CTA final -->
  <section data-nav="dark" class="relative overflow-hidden bg-nuit py-24 text-ivoire md:py-32">
    <div
      class="pointer-events-none absolute inset-0 opacity-40"
      style={`background-image:url(${destinations.items[0].image});background-size:cover;background-position:center;filter:saturate(0.7)`}
      aria-hidden="true"
    >
    </div>
    <div class="absolute inset-0 bg-nuit/85" aria-hidden="true"></div>
    <div class="relative z-10 mx-auto max-w-3xl px-4 text-center md:px-6">
      <div class="gold-rule mx-auto reveal"></div>
      <h2 class="reveal reveal-delay-1 mt-8 font-display text-3xl md:text-5xl">{cta.title}</h2>
      <p class="reveal reveal-delay-2 mt-5 text-ivoire/70">{cta.text}</p>
      <div class="reveal reveal-delay-3 mt-10 flex flex-wrap justify-center gap-3">
        <a
          href={cta.primary.href}
          class="rounded-sm bg-or px-7 py-3.5 text-sm font-medium text-blanc no-underline transition hover:brightness-110"
        >
          {cta.primary.label}
        </a>
        <a
          href={waHref}
          class="rounded-sm border border-ivoire/35 px-7 py-3.5 text-sm text-ivoire no-underline transition hover:border-or hover:text-or"
          target="_blank"
          rel="noopener noreferrer"
        >
          WhatsApp
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
