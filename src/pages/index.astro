---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeHero from '../components/HomeHero.astro';
import ImageCarousel from '../components/ImageCarousel.astro';
import { home } from '../data/content';
import { site } from '../data/site';

const waHref = `https://wa.me/${site.contact.whatsappE164}`;
const { manifesto, gallery, destinations, experiences, journeys, cta } = home;
---

<BaseLayout
  title="Accueil"
  description="Prosperity Travel à Bamako. Billets d’avion, Hadj et Umrah. Organisation de voyages et pèlerinage."
>
  <HomeHero />

  <!-- Manifesto -->
  <section data-nav="light" class="bg-ivoire">
    <div class="site-shell section-pad text-center">
      <div class="mx-auto max-w-4xl">
        <div class="gold-rule mx-auto reveal"></div>
        <p class="reveal type-eyebrow mt-8 text-or">{manifesto.eyebrow}</p>
        <h2 class="reveal reveal-delay-1 type-display mt-5 leading-snug">
          {manifesto.title}
        </h2>
        <p class="reveal reveal-delay-2 type-lead mt-7 text-nuit/70">
          {manifesto.body}
        </p>
      </div>
    </div>
  </section>

  <!-- Destinations -->
  <section data-nav="dark" class="section-pad bg-nuit text-ivoire">
    <div class="site-shell">
      <div class="reveal max-w-4xl">
        <p class="type-eyebrow text-or">{destinations.eyebrow}</p>
        <h2 class="type-display mt-4">{destinations.title}</h2>
        <p class="type-lead mt-5 text-ivoire/65">{destinations.intro}</p>
      </div>

      <ul class="mt-16 grid gap-5 sm:grid-cols-2 lg:grid-cols-4 lg:gap-7">
        {
          destinations.items.map((item, i) => (
            <li class:list={['reveal', i === 1 && 'reveal-delay-1', i === 2 && 'reveal-delay-2', i === 3 && 'reveal-delay-3']}>
              <a href={item.href} class="group block no-underline">
                <div class="dest-card relative aspect-[3/4] overflow-hidden">
                  <img
                    src={item.image}
                    alt={item.name}
                    class="img-zoom h-full w-full object-cover"
                    width="800"
                    height="1067"
                    loading="lazy"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-nuit via-nuit/25 to-transparent" />
                  <div class="dest-card__overlay absolute inset-x-0 bottom-0">
                    <p class="type-eyebrow text-[0.7rem] text-or">{item.region}</p>
                    <h3 class="type-title mt-2">{item.name}</h3>
                    <p class="type-body mt-3 text-ivoire/70 opacity-0 transition duration-500 group-hover:opacity-100">
                      {item.blurb}
                    </p>
                  </div>
                </div>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <ImageCarousel eyebrow={gallery.eyebrow} title={gallery.title} slides={gallery.slides} />

  <!-- Expériences -->
  <section data-nav="light" class="section-pad bg-ivoire">
    <div class="site-shell">
      <div class="reveal">
        <p class="type-eyebrow text-or">{experiences.eyebrow}</p>
        <h2 class="type-display mt-4">{experiences.title}</h2>
      </div>
      <ul class="mt-16 divide-y divide-nuit/10 border-y border-nuit/10">
        {
          experiences.items.map((item, i) => (
            <li class:list={['reveal', `reveal-delay-${(i % 3) + 1}`]}>
              <a
                href={item.href}
                class="group flex flex-col gap-4 py-10 no-underline transition md:flex-row md:items-baseline md:gap-12 md:py-14 lg:gap-16"
              >
                <span class="font-mono text-sm tracking-widest text-or md:text-base">{item.id}</span>
                <h3 class="type-title shrink-0 text-nuit transition group-hover:text-azur md:w-72 lg:w-80">
                  {item.title}
                </h3>
                <p class="type-body max-w-2xl text-nuit/65">{item.text}</p>
                <span class="ml-auto hidden text-xl text-azur transition group-hover:translate-x-1 md:inline">→</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Parcours -->
  <section data-nav="light" class="border-t border-nuit/5 bg-ivoire pb-12 md:pb-16 lg:pb-20">
    <div class="site-shell">
      <div class="reveal mb-12 md:mb-14">
        <p class="type-eyebrow text-or">{journeys.eyebrow}</p>
        <h2 class="type-display mt-4">{journeys.title}</h2>
      </div>
      <ul class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4 lg:gap-10">
        {
          journeys.items.map((item, i) => (
            <li
              class:list={[
                'reveal border-t border-or/60 pt-6',
                i === 1 && 'reveal-delay-1',
                i === 2 && 'reveal-delay-2',
                i === 3 && 'reveal-delay-3',
              ]}
            >
              <h3 class="type-title">{item.title}</h3>
              <p class="type-body mt-3 text-nuit/65">{item.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- CTA final -->
  <section data-nav="dark" class="relative overflow-hidden bg-nuit text-ivoire">
    <div
      class="pointer-events-none absolute inset-0 opacity-40"
      style={`background-image:url(${destinations.items[0].image});background-size:cover;background-position:center;filter:saturate(0.7)`}
      aria-hidden="true"
    >
    </div>
    <div class="absolute inset-0 bg-nuit/85" aria-hidden="true"></div>
    <div class="site-shell section-pad relative z-10 text-center">
      <div class="mx-auto max-w-4xl">
        <div class="gold-rule mx-auto reveal"></div>
        <h2 class="reveal reveal-delay-1 type-display-lg mt-8">{cta.title}</h2>
        <p class="reveal reveal-delay-2 type-lead mt-6 text-ivoire/70">{cta.text}</p>
        <div class="reveal reveal-delay-3 mt-12 flex flex-wrap justify-center gap-4">
          <a
            href={cta.primary.href}
            class="btn-lg rounded-sm bg-or font-medium text-blanc no-underline transition hover:brightness-110"
          >
            {cta.primary.label}
          </a>
          <a
            href={waHref}
            class="btn-lg rounded-sm border border-ivoire/35 text-ivoire no-underline transition hover:border-or hover:text-or"
            target="_blank"
            rel="noopener noreferrer"
          >
            WhatsApp
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
