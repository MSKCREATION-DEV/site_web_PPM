---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { about } from '../data/content';
---

<BaseLayout
  title="À propos"
  description="Prosperity Travel à Bamako. Présentation de l’agence de voyage et de billetterie."
>
  <PageHero
    eyebrow={about.hero.eyebrow}
    title={about.hero.title}
    image={about.hero.image}
    imageAlt="Avion en vol"
    compact
  />

  <section data-nav="light" class="bg-ivoire py-20 md:py-28">
    <div class="mx-auto grid max-w-6xl gap-14 px-4 md:grid-cols-12 md:px-6">
      <div class="reveal md:col-span-5">
        <div class="gold-rule"></div>
        <h2 class="mt-6 font-display text-3xl md:text-4xl">{about.story.title}</h2>
      </div>
      <div class="reveal reveal-delay-1 space-y-5 md:col-span-7">
        {
          about.story.body.map((p) => (
            <p class="text-base leading-relaxed text-nuit/75 md:text-lg">{p}</p>
          ))
        }
      </div>
    </div>
  </section>

  <section data-nav="dark" class="bg-nuit py-20 text-ivoire md:py-28">
    <div class="mx-auto max-w-6xl px-4 md:px-6">
      <p class="reveal text-xs tracking-[0.28em] text-or uppercase">Valeurs</p>
      <h2 class="reveal reveal-delay-1 mt-3 font-display text-3xl md:text-4xl">Notre façon de travailler</h2>
      <ul class="mt-14 grid gap-8 sm:grid-cols-2">
        {
          about.values.map((v, i) => (
            <li
              class:list={[
                'reveal border-t border-or/40 pt-6',
                i % 2 === 1 && 'reveal-delay-1',
                i >= 2 && 'reveal-delay-2',
              ]}
            >
              <h3 class="font-display text-2xl">{v.title}</h3>
              <p class="mt-3 text-sm text-ivoire/65 md:text-base">{v.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section data-nav="light" class="bg-ivoire py-16 text-center md:py-20">
    <div class="reveal mx-auto max-w-xl px-4">
      <p class="text-nuit/60">Une question ou un devis ? Contactez-nous.</p>
      <a
        href="/contact"
        class="mt-6 inline-block rounded-sm bg-or px-7 py-3.5 text-sm font-medium text-blanc no-underline transition hover:brightness-110"
      >
        Nous contacter
      </a>
    </div>
  </section>
</BaseLayout>
