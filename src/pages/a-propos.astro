---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { about } from '../data/content';
---

<BaseLayout
  title="À propos"
  description="Prosperity Travel à Bamako. Présentation de l’agence de voyage et de billetterie."
>
  <PageHero
    eyebrow={about.hero.eyebrow}
    title={about.hero.title}
    image={about.hero.image}
    imageAlt="Voyageuse face aux dunes — Prosperity Travel"
    compact
  />

  <section data-nav="light" class="section-pad bg-ivoire">
    <div class="site-shell grid gap-14 md:grid-cols-12 md:gap-16 lg:gap-20">
      <div class="reveal md:col-span-5">
        <div class="gold-rule"></div>
        <h2 class="type-display mt-6">{about.story.title}</h2>
      </div>
      <div class="reveal reveal-delay-1 space-y-6 md:col-span-7">
        {
          about.story.body.map((p) => (
            <p class="type-lead text-nuit/75">{p}</p>
          ))
        }
      </div>
    </div>
  </section>

  <section data-nav="light" class="border-t border-nuit/5 bg-ivoire pb-[clamp(4.5rem,7.5vw,9rem)]">
    <div class="site-shell grid gap-12 md:grid-cols-2 md:gap-16 lg:gap-24">
      <div class="reveal">
        <p class="type-eyebrow text-or">{about.mission.title}</p>
        <p class="type-title mt-5 leading-snug text-nuit">{about.mission.text}</p>
      </div>
      <div class="reveal reveal-delay-1">
        <p class="type-eyebrow text-or">{about.vision.title}</p>
        <p class="type-title mt-5 leading-snug text-nuit">{about.vision.text}</p>
      </div>
    </div>
  </section>

  <section data-nav="dark" class="section-pad bg-nuit text-ivoire">
    <div class="site-shell">
      <p class="reveal type-eyebrow text-or">Valeurs</p>
      <h2 class="reveal reveal-delay-1 type-display mt-4">Ce qui nous guide</h2>
      <ul class="mt-16 grid gap-10 sm:grid-cols-3 lg:gap-12">
        {
          about.values.map((v, i) => (
            <li
              class:list={[
                'reveal border-t border-or/40 pt-7',
                i === 1 && 'reveal-delay-1',
                i === 2 && 'reveal-delay-2',
              ]}
            >
              <h3 class="type-title">{v.title}</h3>
              <p class="type-body mt-4 text-ivoire/65">{v.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section data-nav="light" class="bg-ivoire py-16 text-center md:py-24">
    <div class="site-shell reveal text-center">
      <div class="mx-auto max-w-xl">
        <p class="type-lead text-nuit/60">Une question ou un devis ? Contactez-nous.</p>
        <a
          href="/contact"
          class="btn-lg mt-8 inline-block rounded-sm bg-azur-profond font-medium text-blanc no-underline transition hover:bg-azur"
        >
          Nous contacter
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
