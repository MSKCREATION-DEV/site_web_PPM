---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import AboutIdentity from '../components/AboutIdentity.astro';
import DirectorMessage from '../components/DirectorMessage.astro';
import TeamGrid from '../components/TeamGrid.astro';
import TeamShowcase from '../components/TeamShowcase.astro';
import { about } from '../data/content';
---

<BaseLayout
  title="À propos"
  description="Prosperity Travel à Bamako. Équipe, direction et agence de voyage — billets d’avion, Hadj et Umrah."
>
  <PageHero
    eyebrow={about.hero.eyebrow}
    title={about.hero.title}
    image={about.hero.image}
    imageAlt="Voyageuse face aux dunes — Prosperity Travel"
    compact
  />

  <AboutIdentity
    storyEyebrow={about.story.eyebrow}
    storyTitle={about.story.title}
    storyLead={about.story.lead}
    practical={about.story.practical}
    practicalNote={about.story.practicalNote}
    missionEyebrow={about.mission.eyebrow}
    missionText={about.mission.text}
    visionEyebrow={about.vision.eyebrow}
    visionText={about.vision.text}
  />

  <DirectorMessage
    eyebrow={about.director.eyebrow}
    title={about.director.title}
    name={about.director.name}
    role={about.director.role}
    quote={about.director.quote}
    image={about.director.image}
    initials={about.director.initials}
    imageAlt={about.director.imageAlt}
    brand={about.director.brand}
  />

  <TeamShowcase
    eyebrow={about.teamScene.eyebrow}
    titleLead={about.teamScene.titleLead}
    titleAccent={about.teamScene.titleAccent}
    text={about.teamScene.text}
    image={about.teamScene.image}
    imageAlt={about.teamScene.imageAlt}
    highlights={about.teamScene.highlights}
    values={about.teamScene.values}
  />

  <TeamGrid
    eyebrow={about.team.eyebrow}
    title={about.team.title}
    kicker={about.team.kicker}
    members={about.team.members}
  />

  <section data-nav="dark" class="section-pad relative overflow-hidden bg-nuit text-ivoire">
    <div
      class="pointer-events-none absolute inset-0 opacity-40"
      style="background:radial-gradient(ellipse 60% 50% at 10% 20%, rgba(47,138,208,0.35), transparent 60%), radial-gradient(ellipse 50% 40% at 90% 80%, rgba(201,162,78,0.18), transparent 55%)"
      aria-hidden="true"
    >
    </div>
    <div class="site-shell relative z-10">
      <p class="reveal type-eyebrow text-or">Valeurs charte</p>
      <h2 class="reveal reveal-delay-1 type-display mt-4">Ce qui nous guide</h2>
      <ul class="mt-16 grid gap-10 sm:grid-cols-3 lg:gap-12">
        {
          about.values.map((v, i) => (
            <li
              class:list={[
                'reveal group border-t border-or/40 pt-7 transition duration-500 hover:border-or',
                i === 1 && 'reveal-delay-1',
                i === 2 && 'reveal-delay-2',
              ]}
            >
              <h3 class="type-title transition duration-500 group-hover:text-or">{v.title}</h3>
              <p class="type-body mt-4 text-ivoire/65">{v.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section data-nav="light" class="bg-ivoire py-16 text-center md:py-24">
    <div class="site-shell reveal text-center">
      <div class="mx-auto max-w-xl">
        <p class="type-lead text-nuit/60">Une question ou un devis ? Contactez-nous.</p>
        <a
          href="/contact"
          class="btn-lg mt-8 inline-block rounded-sm bg-azur-profond font-medium text-blanc no-underline transition hover:bg-azur"
        >
          Nous contacter
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
